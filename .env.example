# ==============================================================================
# FLEETFLOW AI - Environment Configuration Template
# ==============================================================================

# Global / Common
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=fleetflow-super-secret-development-key-change-in-production-2026

# PostgreSQL Database (Local Docker Compose or Supabase / Render)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://fleetflow_user:fleetflow_secure_pass@localhost:5432/fleetflow_db
DB_NAME=fleetflow_db
DB_USER=fleetflow_user
DB_PASSWORD=fleetflow_secure_pass
DB_HOST=localhost
DB_PORT=5432

# Django Backend Service
DJANGO_PORT=8000
DJANGO_HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FastAPI ML & Tracking Microservice
FASTAPI_PORT=8001
FASTAPI_HOST=0.0.0.0
FASTAPI_SERVICE_URL=http://localhost:8001
DJANGO_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=fleetflow-internal-service-secret-key-2026

# Frontend (Vite)
VITE_DJANGO_API_URL=http://localhost:8000
VITE_FASTAPI_API_URL=http://localhost:8001
